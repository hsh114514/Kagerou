+/*
+ * R5G: the manager app never calls reboot(2) with the install magic itself --
+ * it scans its own /proc/self/fd for a "[ksu_driver]" anon inode.  So the
+ * syscall-table prctl hook hands it one the first time it asks for the legacy
+ * version, otherwise every KSU_IOCTL_* fails with fd == -1.
+ */
+bool ksu_has_driver_fd(void)
+{
+    struct files_struct *files = current->files;
+    struct fdtable *fdt;
+    unsigned int i;
+    bool found = false;
+
+    if (!files)
+        return false;
+
+    spin_lock(&files->file_lock);
+    fdt = files_fdtable(files);
+    for (i = 0; i < fdt->max_fds; i++) {
+        struct file *f = fcheck_files(files, i);
+
+        if (f && f->f_op == &anon_ksu_fops) {
+            found = true;
+            break;
+        }
+    }
+    spin_unlock(&files->file_lock);
+
+    return found;
+}
